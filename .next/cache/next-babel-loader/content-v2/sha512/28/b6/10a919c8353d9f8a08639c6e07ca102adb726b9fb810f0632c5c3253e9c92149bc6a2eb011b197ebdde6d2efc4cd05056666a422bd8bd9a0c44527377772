#d8195e;\n  box-shadow: rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px,\n    rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;\n\n  button {\n    margin: 1rem 0 0.5rem 0;\n  }\n`;\n\n// a basic form\nconst CustomForm = ({ status, message, onValidated }) => {\n  let email;\n  let name;\n\n  const submit = () =>\n    email &&\n    name &&\n    email.value.indexOf(\"@\") > -1 &&\n    onValidated({\n      EMAIL: email.value,\n      NAME: name.value,\n    });\n\n  return (\n    <>\n      <input\n        ref={(node) => (name = node)}\n        type=\"text\"\n        placeholder=\"Your name\"\n      />\n      <br />\n      <input\n        ref={(node) => (email = node)}\n        type=\"email\"\n        placeholder=\"Your email\"\n      />\n      <br />\n      <button onClick={submit}>Submit</button>\n      {status === \"sending\" && <div style={{ color: \"blue\" }}>sending...</div>}\n      {status === \"error\" && (\n        <div\n          style={{ color: \"red\" }}\n          dangerouslySetInnerHTML={{ __html: message }}\n        />\n      )}\n      {status === \"success\" && (\n        <div\n          style={{ color: \"green\" }}\n          dangerouslySetInnerHTML={{ __html: message }}\n        />\n      )}\n    </>\n  );\n};\n\nexport default function Subscribe() {\n  // 1. Create a reference to the input so we can fetch/clear it's value.\n  const url =\n    \"https://jacklyons.us16.list-manage.com/subscribe/post?u=9f82d3f200391b066ef73f021&amp;id=cf45a34209\";\n\n  return (\n    <StyledSubscribe>\n      <h3>Sign up for more hot tips in your inbox!</h3>\n      <div>I'll only send emails when new content is posted. No spam.</div>\n      <MailchimpSubscribe\n        url={url}\n        render={({ subscribe, status, message }) => (\n          <CustomForm\n            status={status}\n            message={message}\n            onValidated={(formData) => subscribe(formData)}\n          />\n        )}\n      />\n    </StyledSubscribe>\n  );\n}\n"]},"metadata":{},"sourceType":"module"}