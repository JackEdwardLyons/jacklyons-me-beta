.frontmatter.image\", null)\n                  )}\n                  alt={_.get(this.props, \"page.frontmatter.image_alt\", null)}\n                />\n              </div>\n            )}\n            <div className=\"post-content inner-sm\">\n              {markdownify(_.get(this.props, \"page.markdown\", null))}\n\n              <hr />\n\n              <div\n                dangerouslySetInnerHtml={{\n                  __html: shortcodeTest(\n                    \"some content here [signup_form] jack lyons\"\n                  ),\n                }}\n              />\n              <Subscribe />\n            </div>\n\n            <footer className=\"post-meta inner-sm\">\n              <time\n                className=\"published\"\n                dateTime={moment(\n                  _.get(this.props, \"page.frontmatter.date\", null)\n                ).strftime(\"%Y-%m-%d %H:%M\")}\n              >\n                {moment(\n                  _.get(this.props, \"page.frontmatter.date\", null)\n                ).strftime(\"%B %d, %Y\")}\n              </time>\n\n              {/* <DisqusComments\n                post={{\n                  title: postTitle,\n                  id: postTitle.toLowerCase().replace(/\\s+/gi, \"_\"),\n                  url: postPath,\n                }}\n              /> */}\n            </footer>\n          </article>\n        </div>\n      </Layout>\n    );\n  }\n}\n"]},"metadata":{},"sourceType":"module"}