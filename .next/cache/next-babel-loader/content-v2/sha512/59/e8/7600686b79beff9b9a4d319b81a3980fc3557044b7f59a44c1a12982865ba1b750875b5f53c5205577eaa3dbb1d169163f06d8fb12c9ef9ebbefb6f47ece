{"ast":null,"code":"import _ from \"lodash\";\n/**\n * Get the page at the provided `filePath`.\n *\n * @param {Array} pages Array of page objects. All pages must have '__metadata.urlPath' field.\n * @param {string} filePath The file path to find the page by\n * @return {Object}\n */\n\nexport default function getPageByFilePath(pages, filePath) {\n  filePath = _.trim(filePath, \".md\");\n  const urlPath = filePath.replace(/^\\/?content\\/pages\\//, \"\");\n  return _.find(pages, page => {\n    const pageUrlPath = _.trim(_.get(page, \"__metadata.urlPath\"), \"/\");\n\n    return urlPath === pageUrlPath;\n  });\n}","map":{"version":3,"sources":["/Users/jack__lyons/Documents/Web Projects/jacklyons-me/src/utils/getPageByFilePath.js"],"names":["_","getPageByFilePath","pages","filePath","trim","urlPath","replace","find","page","pageUrlPath","get"],"mappings":"AAAA,OAAOA,CAAP,MAAc,QAAd;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AACA,eAAe,SAASC,iBAAT,CAA2BC,KAA3B,EAAkCC,QAAlC,EAA4C;AACzDA,EAAAA,QAAQ,GAAGH,CAAC,CAACI,IAAF,CAAOD,QAAP,EAAiB,KAAjB,CAAX;AACA,QAAME,OAAO,GAAGF,QAAQ,CAACG,OAAT,CAAiB,sBAAjB,EAAyC,EAAzC,CAAhB;AAEA,SAAON,CAAC,CAACO,IAAF,CAAOL,KAAP,EAAeM,IAAD,IAAU;AAC7B,UAAMC,WAAW,GAAGT,CAAC,CAACI,IAAF,CAAOJ,CAAC,CAACU,GAAF,CAAMF,IAAN,EAAY,oBAAZ,CAAP,EAA0C,GAA1C,CAApB;;AACA,WAAOH,OAAO,KAAKI,WAAnB;AACD,GAHM,CAAP;AAID","sourcesContent":["import _ from \"lodash\";\n\n/**\n * Get the page at the provided `filePath`.\n *\n * @param {Array} pages Array of page objects. All pages must have '__metadata.urlPath' field.\n * @param {string} filePath The file path to find the page by\n * @return {Object}\n */\nexport default function getPageByFilePath(pages, filePath) {\n  filePath = _.trim(filePath, \".md\");\n  const urlPath = filePath.replace(/^\\/?content\\/pages\\//, \"\");\n\n  return _.find(pages, (page) => {\n    const pageUrlPath = _.trim(_.get(page, \"__metadata.urlPath\"), \"/\");\n    return urlPath === pageUrlPath;\n  });\n}\n"]},"metadata":{},"sourceType":"module"}